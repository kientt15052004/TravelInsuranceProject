<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	 version="6.0">

    <!-- Welcome file list -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
        <welcome-file>home.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlet Mappings -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>Controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>Controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InsuranceListController</servlet-name>
        <servlet-class>Controller.InsuranceListController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InsuranceListController</servlet-name>
        <url-pattern>/insurance-list</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PurchaseInsuranceController</servlet-name>
        <servlet-class>Controller.PurchaseInsuranceController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PurchaseInsuranceController</servlet-name>
        <url-pattern>/purchase-insurance</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StaffServlet</servlet-name>
        <servlet-class>Controller.StaffServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffServlet</servlet-name>
        <url-pattern>/staff</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CreateContractServlet</servlet-name>
        <servlet-class>Controller.CreateContractServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateContractServlet</servlet-name>
        <url-pattern>/CreateContractServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TestCreateContract</servlet-name>
        <servlet-class>Controller.TestCreateContract</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestCreateContract</servlet-name>
        <url-pattern>/TestCreateContract</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DebugForm</servlet-name>
        <servlet-class>Controller.DebugForm</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DebugForm</servlet-name>
        <url-pattern>/DebugForm</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SimpleCreateContract</servlet-name>
        <servlet-class>Controller.SimpleCreateContract</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SimpleCreateContract</servlet-name>
        <url-pattern>/SimpleCreateContract</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SimpleCreateContractGet</servlet-name>
        <servlet-class>Controller.SimpleCreateContractGet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SimpleCreateContractGet</servlet-name>
        <url-pattern>/SimpleCreateContractGet</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>SimpleCreateContractServlet</servlet-name>
        <servlet-class>Controller.SimpleCreateContractServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SimpleCreateContractServlet</servlet-name>
        <url-pattern>/SimpleCreateContractServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TestApplicationInsert</servlet-name>
        <servlet-class>Controller.TestApplicationInsert</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestApplicationInsert</servlet-name>
        <url-pattern>/TestApplicationInsert</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TestContractInsert</servlet-name>
        <servlet-class>Controller.TestContractInsert</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestContractInsert</servlet-name>
        <url-pattern>/TestContractInsert</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DebugRealData</servlet-name>
        <servlet-class>Controller.DebugRealData</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DebugRealData</servlet-name>
        <url-pattern>/DebugRealData</url-pattern>
    </servlet-mapping>



    <servlet>
        <servlet-name>TestDBConnection</servlet-name>
        <servlet-class>Controller.TestDBConnection</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestDBConnection</servlet-name>
        <url-pattern>/TestDBConnection</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DebugProducts</servlet-name>
        <servlet-class>Controller.DebugProducts</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DebugProducts</servlet-name>
        <url-pattern>/DebugProducts</url-pattern>
    </servlet-mapping>

    <!-- Session timeout (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
